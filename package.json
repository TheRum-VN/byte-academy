{
  "name": "byte-academy",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web \"npm run dev -w @byte/server\" \"npm run dev -w @byte/web\"",
    "build": "npm run build -w @byte/shared && npm run build -w @byte/web && npm run build -w @byte/server",
    "start": "npm run start -w @byte/server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "npm run db:generate -w @byte/server",
    "db:migrate": "npm run db:migrate -w @byte/server",
    "db:seed": "npm run db:seed -w @byte/server",
    "teacher:create": "npm run teacher:create -w @byte/server",
    "assets:audit": "python -X utf8 scripts/audit_assets.py"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "typescript-eslint": "^8.48.0",
    "globals": "^16.5.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "prettier": "^3.6.0",
    "concurrently": "^9.2.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.19.0",
    "supertest": "^7.1.0",
    "@types/supertest": "^6.0.3",
    "tsx": "^4.20.0"
  }
}
