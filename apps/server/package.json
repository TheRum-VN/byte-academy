{
  "name": "@byte/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --import ./dist/config/production.js dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx src/database/seed.ts",
    "teacher:create": "tsx src/database/create-teacher.ts"
  },
  "dependencies": {
    "@byte/shared": "*",
    "express": "^5.1.0",
    "socket.io": "^4.8.1",
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.1.0",
    "express-rate-limit": "^8.2.0",
    "dotenv": "^17.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "prisma": "^6.19.0",
    "@types/express": "^5.0.0",
    "@types/cookie-parser": "^1.4.9"
  }
}
